{
  "name": "diyboard",
  "version": "0.1.0",
  "private": true,
  "description": "Animated developer dashboard for an Android tablet connected over USB (adb reverse).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmedgito/diyboard.git"
  },
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node server/src/index.ts",
    "go": "npm run build && npm start",
    "build": "vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "apk": "node scripts/apk.ts",
    "autostart": "node scripts/autostart.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.8",
    "vite": "^6.4.6"
  }
}
